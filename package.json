{
  "name": "trio-mio-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:java": "VITE_API_PROXY=http://localhost:8080 vite",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_BASE=/toy-ecommerce/ VITE_USE_BROWSER_API=true tsc -b && VITE_BASE=/toy-ecommerce/ VITE_USE_BROWSER_API=true vite build",
    "preview": "vite preview",
    "deploy:pages": "npm run build:pages && gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
