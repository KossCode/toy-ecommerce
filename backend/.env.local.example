# Copy to backend/.env.local (gitignored). Required for local demo login.
# Password must be at least 12 characters.
app.demo.user-password=change-me-local-12

# Optional ceiling (default DRY_RUN). Never set LIVE here without an explicit yes in chat.
# INTEGRATIONS_MAX_MODE=DRY_RUN

# Public feed URL token (path segment). Change in prod via SSM / APP_FEEDS_TOKEN.
# APP_FEEDS_TOKEN=local-dev-feeds-token
# APP_PUBLIC_BASE_URL=http://localhost:8080
# APP_FEEDS_DIR=./.local-feeds

# AES-256 master key: Base64 of exactly 32 raw bytes. Local profile falls back automatically;
# prod must set APP_CRYPTO_MASTER_KEY (SSM). Example generator:
#   printf 'your-exact-32-byte-secret-here!!' | base64
# APP_CRYPTO_MASTER_KEY=
